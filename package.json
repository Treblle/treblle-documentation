{
    "name": "treblle-documentation",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "next build --webpack",
        "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
        "commit": "cz",
        "dev": "rm -rf .next && next dev --webpack",
        "format:check": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint": "next lint",
        "prepare": "panda codegen",
        "start": "next start",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ark-ui/react": "^5.39.3",
        "@sanity/client": "^7.27.0",
        "@statsig/react-bindings": "^3.33.5",
        "@statsig/web-analytics": "^3.33.5",
        "cheerio": "^1.2.0",
        "jsdom": "^29.1.1",
        "lucide-react": "^0.577.0",
        "next": "^16.4.2",
        "nextra": "4.6.1",
        "nextra-theme-docs": "4.6.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "turndown": "^7.2.4"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.4.2",
        "@pandacss/dev": "^1.12.1",
        "@types/jsdom": "^28.0.3",
        "@types/node": "20.17.14",
        "@types/react": "^19.3.0",
        "@types/turndown": "^5.0.6",
        "eslint": "^10.13.0",
        "pagefind": "^1.5.2",
        "prettier": "^3.9.10",
        "prettier-plugin-packagejson": "^3.0.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "packageManager": "pnpm@9.5.0"
}
