        "nextra": "4.6.1",
        "nextra-theme-docs": "4.6.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "turndown": "^7.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "16.4.6",
        "@pandacss/dev": "^2.6.0",
